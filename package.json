{
  "name": "review-viewer",
  "version": "0.1.0",
  "description": "レビュー資料(Markdown)とソースコードをブラウザで並べて読み、コメントを付けるローカルツール",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "npm run build:server && node dist/server/dev.js",
    "build": "npm run clean && npm run build:server && npm run build:client",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:server": "tsc -p tsconfig.build.json",
    "build:client": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "start": "node dist/server/index.js",
    "e2e": "vitest run --config e2e/vitest.config.ts",
    "prepare": "git config core.hooksPath .githooks || echo \"prepare: core.hooksPath を設定できませんでした(git リポジトリ外?)\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "playwright": "1.64.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "hono": "4.13.13",
    "ignore": "7.0.12",
    "mermaid": "12.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "shiki": "4.5.0",
    "unified": "11.0.5"
  }
}
