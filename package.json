{
  "name": "review-viewer",
  "version": "0.1.0",
  "description": "レビュー資料(Markdown)とソースコードをブラウザで並べて読み、コメントを付けるローカルツール",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && npm run build:server && npm run build:client",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:server": "tsc -p tsconfig.build.json",
    "build:client": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "start": "node dist/server/index.js",
    "e2e": "vitest run --config e2e/vitest.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "playwright": "1.64.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "hono": "4.13.13",
    "ignore": "7.0.12"
  }
}
